# Path to the OKF bundle directory the agent manages
BUNDLE_ROOT=./sample-bundle

# ── Agent context bounds ───────────────────────────────────────────────
# Maximum model/tool round-trips per query or mutation. The final allowed
# generation is reserved for synthesis, so values below 2 become 2.
#AGENT_MAX_STEPS=8
# Chat has a larger but still bounded budget for interactive multi-step work.
#AGENT_CHAT_MAX_STEPS=32
# Maximum body characters returned by one read_concept page. Use next_offset
# to page through larger documents while the per-run payload budget remains.
#AGENT_MAX_DOCUMENT_CHARS=12000
# Deterministic per-run character budget for JSON-serialised tool results only.
# The implementation reserves the notice, 32 JSON characters of fixed SDK
# framing headroom, and 64 characters for a visible truncation marker before
# fitting payloads (an accounting bound, not an absolute wire-byte ceiling).
# Values below the safe minimum are clamped.
#AGENT_MAX_TOOL_RESULT_CHARS=24000
# Dynamic compact tree and existing concept types embedded in the system prompt.
# Values below 240 are clamped so both truncation markers remain visible.
# Search and list_directory remain available when this context is truncated.
#AGENT_MAX_SYSTEM_CONTEXT_CHARS=24000
# Maximum caller input and cumulative model-generated write arguments, measured as
# input characters or deterministic JSON-serialised characters (default 32000).
#AGENT_MAX_INPUT_CHARS=32000
# ── Primary model ──────────────────────────────────────────────────────
# Any OpenAI-compatible or Anthropic-compatible API endpoint.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_FORMAT=openai          # "openai" | "anthropic"
LLM_MODEL=                     # model id to request, e.g. "deepseek-chat" or "claude-sonnet-5"

# ── Fallback model (optional) ──────────────────────────────────────────
# Used when the primary model fails with a retryable error (timeout, 5xx).
# Leave LLM_FALLBACK_API_BASE_URL empty to disable fallback.
LLM_FALLBACK_API_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_FORMAT=openai
LLM_FALLBACK_MODEL=
# LLM_FALLBACK_ALLOW_FOR=query   # optional: restrict to read-only operations

# ── Legacy env vars (still work but deprecated) ─────────────────────────
# Prefer the LLM_API_* vars above. These are mapped automatically.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# LLAMACPP_BASE_URL=
# LLAMACPP_API_KEY=
# LOCAL_BASE_URL=
# LOCAL_API_KEY=

# Commit bundle changes to git after each mutation
GIT_AUTOCOMMIT=false

PORT=3800

# Optional: require "Authorization: Bearer <token>" on /mcp and /api.
# Unset = open (fine for localhost/LAN). Set this before exposing understory anywhere.
#AUTH_TOKEN=

# Query cache: repeated memory_query questions answer from cache until the
# bundle changes. QUERY_CACHE=false disables; QUERY_CACHE_TTL e.g. "1h" (default 24h).
#QUERY_CACHE=true
#QUERY_CACHE_TTL=24h

# Hot memory: recent writes + recent answers form a working set that queries
# check with one cheap tool-free LLM call before the full agent run.
#HOT_MEMORY=true
#HOT_MEMORY_TTL=1h
#HOT_MEMORY_MAX_OUTPUT_TOKENS=2048   # generation cap, REASONING TOKENS INCLUDED:
#  llama.cpp bills thinking tokens against max_tokens, so a low cap would cut
#  the reply off mid-sentence. That is now declined instead of answered, and
#  overrides LLM_MAX_OUTPUT_TOKENS for this layer — see the RECALL_ block below
#  for the same knob on the layer that runs after this one.

# Recall: deterministic retrieval (keyword search plus one hop of the link
# graph, no LLM at all) followed by one tool-free generation, run after hot
# memory and before the full agent run. RECALL=false disables it.
#RECALL=true
#RECALL_SEEDS=3                # search hits that seed the link-graph walk
#RECALL_CANDIDATES=6           # concepts read after expansion
#RECALL_MIN_SCORE=20           # top-hit confidence needed to trust keyword search
#RECALL_EXCERPT_CHARS=6000     # body characters per concept sent to the model
#RECALL_MAX_OUTPUT_TOKENS=2048 # generation cap, REASONING TOKENS INCLUDED:
#  llama.cpp bills thinking tokens against max_tokens and ignores the knob
#  below, so a low value truncates the answer instead of shortening the
#  thinking trace. A run that hits it is declined, not returned.
#RECALL_THINKING_BUDGET=128    # asks a thinking model to stay in budget, via
#  vLLM's chat_template_kwargs. llama.cpp ignores it entirely and charges the
#  thinking to RECALL_MAX_OUTPUT_TOKENS instead.

# Dreaming: autonomous memory consolidation on an interval (opt-in).
# Deterministic signals (orphans, broken links, likely duplicates, oversized
# concepts, recent activity) decide if there's anything to do — a healthy
# memory costs nothing.
#DREAM_INTERVAL=6h
#DREAM_INSIGHTS=true
